{
  "name": "@clynamic/dmark",
  "version": "0.0.7",
  "description": "Two-way dtext ↔ markdown parser with shared AST. Verified against the e621ng/dtext ruby renderer.",
  "license": "UNLICENSED",
  "author": "binaryfloof",
  "publishConfig": {
    "registry": "https://npm.clynamic.net/"
  },
  "type": "module",
  "main": "dist/dmark.cjs",
  "module": "dist/dmark.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/dmark.js",
      "require": "./dist/dmark.cjs",
      "default": "./dist/dmark.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "build:watch": "node scripts/build.mjs --watch",
    "build:preview": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "check": "npm run fmt:check && npm run lint && npm run typecheck",
    "corpus:fetch": "tsx scripts/fetch-corpus.ts",
    "corpus:survey": "tsx scripts/corpus-survey.ts",
    "corpus:curate": "tsx scripts/curate-corpus.ts",
    "corpus:build": "npm run corpus:fetch && npm run corpus:survey && npm run corpus:curate",
    "oracle:build": "docker build -t dmark-oracle:dev oracle",
    "oracle:smoke": "tsx scripts/oracle-smoke.ts"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.0",
    "csv-parse": "^6.2.1",
    "esbuild": "^0.28.0",
    "markdown-it": "^14.1.1",
    "oxlint": "^1.68.0",
    "parse5": "^7.2.1",
    "prettier": "^3.8.3",
    "testcontainers": "^11.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
